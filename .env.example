# URL of the SGLang server's OpenAI-compatible API.
# On this machine (no local GPU), point this at a remote CUDA host, e.g.:
# SGLANG_BASE_URL=http://<remote-gpu-host>:30000/v1
SGLANG_BASE_URL=http://localhost:30000/v1

# Model checkpoint SGLang is serving. Must match what the SGLang server was launched with.
SGLANG_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# SGLang doesn't require a real API key by default; the OpenAI client needs some value.
SGLANG_API_KEY=EMPTY

SGLANG_TIMEOUT_SECONDS=120
SGLANG_MAX_TOKENS=4096

MAX_UPLOAD_SIZE_MB=20
PDF_RASTERIZE_DPI=200
